Depends: python3 (>= 3.11), python3-aiohttp (>= 3.8), python3-numpy (>= 1:1.24), python3-gi, gir1.2-gtk-3.0, gir1.2-webkit2-4.1 | gir1.2-webkit2-4.0
Recommends: rtl-sdr
Section: hamradio
