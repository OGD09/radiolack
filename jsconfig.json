// Type check of the web interface: plain JavaScript with JSDoc types,
// checked by TypeScript without producing any file. See README.md.
{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": []
  },
  "include": ["src/radiolack/web/**/*.js"]
}
